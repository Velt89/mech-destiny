# Mech Destiny — local dev env (copy to .env; never commit .env)
# PI_SANDBOX=true keeps all Pi payments in Sandbox (no real Pi moves).
PI_SANDBOX=true
# Server API Key from the Pi Developer Web Console (Settings -> Add-ons -> API key).
# Leave empty for mock/sandbox mode. NEVER put it in client-side code.
PI_SERVER_API_KEY=
# Local dev only: lets /api/me return a mock verified user without a Server API Key.
# NEVER set this on Vercel.
DEV_ALLOW_MOCK_AUTH=false
# Persistent shared store (Vercel KV / Upstash Redis) — leave empty for local dev
# (in-memory + ./data/store.json). On Vercel these are AUTO-ADDED when a KV/Redis
# store is attached to the project (Storage -> Create -> KV/Redis); never paste
# real values here, and never put them in client-side code.
# Legacy Vercel KV:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Current Vercel Marketplace Redis (Upstash) — a store created today uses these:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Marketplace Redis (native protocol) — the Redis integration exposes ONLY this
# var (no REST URL/token); the backend speaks native Redis over it (rediss://
# = TLS). This is what mech-destiny-prod uses (store mech-destiny-prod-kv):
# REDIS_URL=
# KV_URL=
